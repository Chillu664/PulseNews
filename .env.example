# Optional. RSS is the default and requires no API key.
# Set NEWS_PROVIDER=gnews and configure GNEWS_API_KEY to prefer GNews.
# NEWS_PROVIDER=rss
# GNEWS_API_KEY=your_gnews_api_key_here

# Optional. Feed results refresh every 15 minutes by default.
# NEWS_REFRESH_INTERVAL_MS=900000

# Optional. Point this at a persistent disk path on your hosting provider.
# DATA_DIR=/var/data

# Preferred: Google Apps Script sends support messages using your Gmail account without an App Password.
# GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id/exec
# GOOGLE_APPS_SCRIPT_SECRET=long_random_shared_secret
# Set SUPPORT_EMAIL_TO and SUPPORT_SHARED_SECRET in the Apps Script project properties.

# Alternative: Gmail SMTP requires an App Password, not your regular Gmail password.
# GMAIL_USER=your-account@gmail.com
# GMAIL_APP_PASSWORD=your_16_character_app_password
# SUPPORT_EMAIL_TO=your-account@gmail.com

# Flutterwave Mobile Money. Configure a live merchant account and MTN payout
# in the Flutterwave dashboard before accepting real donations.
# FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-...
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...
